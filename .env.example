# ──────────────────────────────────────────────────────────
# eSchool Assistant – environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file.
#
# The app works in THREE modes:
#   1. Groq API key set     → AI interpretation via Groq (free tier available)
#   2. OpenAI API key set   → AI interpretation via OpenAI
#   3. Neither key set       → rule-based interpretation (no API key needed)
# ──────────────────────────────────────────────────────────

# ── Option A: Groq (recommended — has a generous free tier) ──
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the Groq model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Option B: OpenAI ────────────────────────────────────────
# OPENAI_API_KEY=sk-your-key-here
# Optional: override the model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Optional: override the base URL for other OpenAI-compatible providers
# (OpenRouter, Azure, local LLM server, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── eSchool settings (usually no need to change) ───────────
# ESCHOOL_BASE_URL=https://eschool.ug
# ESCHOOL_TIMEOUT=30
